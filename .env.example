# OMNI Enterprise - Single-Host / Fresh-Server Deployment
# Copy to .env and adjust values. setup-server.sh can generate missing secrets.
# NEVER commit .env with real secrets.

# --- Core ---
PVE_TARGET_STORAGE=local-data
COMPOSE_PROJECT_NAME=omni-enterprise
TZ=Europe/Berlin
SERVICE_BIND_HOST=0.0.0.0

# --- Images / Build ---
OMNICORE_IMAGE=omnicore-middleware
OMNICORE_TAG=local
OMNIROUTE_IMAGE=diegosouzapw/omniroute
OMNIROUTE_TAG=latest
PYTHON_VERSION=3.11

# --- Middleware / DB ---
POSTGRES_DB=omnicore
POSTGRES_USER=omnichat
POSTGRES_PASSWORD=__GENERATE__
MIDDLEWARE_PORT=8002
UVICORN_WORKERS=1
UVICORN_LOOP=uvloop
UVICORN_HTTP=httptools
DATABASE_PATH=/app/data/middleware.db

# Required secrets (generate with: openssl rand -hex 32)
SESSION_SECRET=__GENERATE__
INTERNAL_API_KEY=__GENERATE__
SECRET_KEY=__GENERATE__
JWT_SECRET=__GENERATE__

# Optional initial admin bootstrap (first start only; change immediately)
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=__GENERATE__
ADMIN_DISPLAY_NAME=Administrator

# --- OmniRoute / AI ---
OMNIROUTE_PORT=20128
REQUIRE_API_KEY=true
OMNIROUTE_API_KEY=__GENERATE__
OMNIROUTE_STORAGE_ENCRYPTION_KEY=__GENERATE__
OMNIROUTE_URL=http://omniroute:20128/v1
OMNIROUTE_BASE_URL=http://omniroute:20128/v1
OMNI_ROUTE_URL=http://omniroute:20128/v1
OMNIROUTE_URL_PUBLIC=
OMNIROUTE_TIMEOUT=60
OMNIROUTE_RETRY=3
OMNIROUTE_DEFAULT_COMBO=auto
OMNIROUTE_SALES_COMBO=auto
OMNIROUTE_DEFAULT_IMAGE_COMBO=auto

# --- Feature flags ---
# Shopware live-sale path is default. External marketplaces are isolated by default.
ENABLE_EXTERNAL_MARKETPLACES=false
ENABLE_MATTERHORN_IMPORT=true
ENABLE_MARKETING_ENGINE=true
ENABLE_SALES_AUTOMATION=true
ENABLE_CHANNEL_ADAPTERS=true
PRODUCT_INTELLIGENCE_ENABLED=true
EXPORT_GATE_MODE=review_required

# --- Shopware (commerce profile) ---
SHOPWARE_PORT=8088
SHOPWARE_ENABLED=false
SHOPWARE_URL=http://shopware
SHOPWARE_CLIENT_ID=
SHOPWARE_CLIENT_SECRET=
SHOPWARE_SALES_CHANNEL_ID=
SHOPWARE_API_VERSION=6.0
SHOPWARE_NAME=shopware-local

# --- Assortment & style targeting (Shopware channel) ---
# clubwear_sexy: target clubwear/nightlife; hard-exclude classic evening/ball/bridal wear.
# all: disable style targeting and evening-wear exclusion.
SHOPWARE_ASSORTMENT_PROFILE=clubwear_sexy

# --- Deterministic pricing engine (EK -> VK) ---
DEFAULT_TARGET_MARGIN_PCT=30
MIN_MARGIN_PCT=12
DEFAULT_TAX_RATE=19
PRICE_ROUNDING_MODE=point_99

# --- Edge / Ops ---
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8080
TRAEFIK_API_INSECURE=false
PORTAINER_HTTP_PORT=9000
PORTAINER_HTTPS_PORT=9443

# --- Optional ZeroTier ---
ZT_ENABLED=false
ZT_NETWORK_ID=
ZT_NODE_NAME=
ZEROTIER_IMAGE=zerotier/zerotier:latest

# --- Optional module images ---
MARKETING_IMAGE=alpine:3.20
SOCIAL_IMAGE=alpine:3.20
CONTENT_STUDIO_IMAGE=alpine:3.20
CODING_SWARM_IMAGE=alpine:3.20
