# Root Single-Host Gesamtstack (.env.example) - Werte kopieren nach .env und Secrets rotieren
COMPOSE_PROJECT_NAME=omni-enterprise
TZ=Europe/Berlin

# --- Images ---
OMNICORE_IMAGE=omnicore-middleware
OMNICORE_TAG=local
OMNIROUTE_IMAGE=diegosouzapw/omniroute
OMNIROUTE_TAG=latest

# --- Middleware / DB ---
POSTGRES_DB=omnicore
POSTGRES_USER=omnichat
POSTGRES_PASSWORD=change_me_strong_db_password
MIDDLEWARE_PORT=8002
SESSION_SECRET=change_me_session_secret
INTERNAL_API_KEY=change_me_internal_api_key
SECRET_KEY=change_me_secret_key
JWT_SECRET=change_me_jwt_secret

# --- OmniRoute ---
OMNIROUTE_PORT=20128
REQUIRE_API_KEY=true
OMNIROUTE_API_KEY=change_me_omniroute_api_key
OMNIROUTE_STORAGE_ENCRYPTION_KEY=change_me_32bytes_min_encryption_key
OMNIROUTE_URL_PUBLIC=https://puchalla.online/v1

# --- Shopware (dev/dockware) ---
SHOPWARE_PORT=8088

# --- Edge / Ops ---
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8080
TRAEFIK_API_INSECURE=false  # set true ONLY for isolated dev; prefer auth/TLS in prod
PORTAINER_HTTP_PORT=9000
PORTAINER_HTTPS_PORT=9443

# --- ZeroTier / Multi-Device Networking (optional, for standalone on different hosts) ---
# Prefer host-installed ZeroTier (scripts/zerotier-host-setup.sh). Container sidecar via profile `zt`.
ZT_ENABLED=false
ZT_NETWORK_ID=
ZT_NODE_NAME=
ZEROTIER_IMAGE=zerotier/zerotier:latest
# Bind published ports (security): 0.0.0.0 (default), 127.0.0.1 (local-only), or a specific ZT IP
SERVICE_BIND_HOST=0.0.0.0
# --- Resilience / URLs (override for multi-device/ZeroTier peers) ---
MIDDLEWARE_INTERNAL_URL=http://middleware:8000
OMNIROUTE_INTERNAL_URL=http://omniroute:20128/v1


# --- Shopware integration (used by middleware when commerce/shopware enabled) ---
SHOPWARE_URL=http://shopware:80
SHOPWARE_CLIENT_ID=
SHOPWARE_CLIENT_SECRET=
SHOPWARE_SALES_CHANNEL_ID=
SHOPWARE_ENABLED=false
OMNIROUTE_URL=http://192.168.176.62:20128/v1
OMNIROUTE_BASE_URL=http://192.168.176.62:20128/v1
OMNIROUTE_DEFAULT_COMBO=coding-primary
OMNIROUTE_SALES_COMBO=omnicore-sales-product-intelligence
PRODUCT_INTELLIGENCE_ENABLED=true
EXPORT_GATE_MODE=review_required
SHOPWARE_MCP_ENABLED=true
SHOPWARE_MCP_URL=http://shopware-mcp:7331
