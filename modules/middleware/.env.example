# Omni-Core Middleware - Standalone (.env.example)
# Kopieren nach .env und Werte anpassen. Pro Node eigene NODE_ID/Ports/Secrets wählen.

NODE_ID=node-a
TZ=Europe/Berlin
OMNI_CORE_PORT=8002

POSTGRES_USER=omnichat
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=omnicore
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data/pgdata

SESSION_SECRET=change_me_session_secret
INTERNAL_API_KEY=
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=change_me_admin_password
ADMIN_DISPLAY_NAME=Administrator
SECRET_KEY=change_me_secret_key
JWT_SECRET=change_me_jwt_secret

OMNIROUTE_URL=http://192.168.176.62:20128/v1
OMNIROUTE_API_KEY=change_me_omniroute_api_key
MATTERHORN_API_TOKEN=

OMNI_MODEL_ADMIN=omni-admin-agent
OMNI_MODEL_CONTENT_SEO=omni-content-seo
OMNI_MODEL_VISION=omni-vision-photo
OMNI_MODEL_VIDEO=omni-video-gen
OMNI_MODEL_CRM=omni-crm-support
OMNI_MODEL_CRM_GDPR=omni-local-gdpr
ENABLE_MARKETING_ENGINE=true
ENABLE_SALES_AUTOMATION=true
ENABLE_CHANNEL_ADAPTERS=true
ENABLE_MATTERHORN_IMPORT=true

OMNI_CORE_ENABLED=true
OMNI_CORE_SYNC_MODE=api_webhook_only
OMNI_CORE_SYNC_IDEMPOTENCY=true
OMNI_CORE_CONFLICT_STRATEGY=report_only_no_silent_overwrite

# --- Dev Agent / OmniRoute (standalone) ---
# Lasse AGENT_BASE_URL/AGENT_API_KEY leer, um OMNIROUTE_URL/OMNIROUTE_API_KEY zu verwenden.
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=omni-admin-agent
AGENT_MAX_STEPS=30
CODING_AGENT_IMAGE=omnicore-coding-agent:standalone

# --- Externe Medien (Produktbilder ausgelagert) ---
# Host-Pfade (können auf NFS/externes Storage gemountet werden)
MEDIA_PATH=./data/media
UPLOADS_PATH=./data/uploads

# --- Image/Build ---
OMNICORE_IMAGE=ghcr.io/local/omnicore-middleware
OMNICORE_TAG=1.0.0
PYTHON_VERSION=3.11
OMNIROUTE_BASE_URL=http://192.168.176.62:20128/v1
OMNI_ROUTE_URL=
OMNIROUTE_TIMEOUT=60
OMNIROUTE_RETRY=3
UVICORN_WORKERS=1
UVICORN_LOOP=uvloop
UVICORN_HTTP=httptools

# --- ZeroTier / Multi-Device Networking (optional, for standalone on different hosts) ---
# Prefer host-installed ZeroTier (scripts/zerotier-host-setup.sh). Container sidecar via profile `zt`.
ZT_ENABLED=false
ZT_NETWORK_ID=
ZT_NODE_NAME=
ZEROTIER_IMAGE=zerotier/zerotier:latest
# Bind published ports (security): 0.0.0.0 (default), 127.0.0.1 (local-only), or a specific ZT IP
SERVICE_BIND_HOST=0.0.0.0


# --- Shopware 6 Integration (Middleware -> Shopware, API-only) ---
# Set when connecting to a Shopware instance (modules/shopware or external).
# SHOPWARE_URL must be reachable from the middleware container (e.g. http://shopware:80 in shared network, or host/ZT IP).
SHOPWARE_URL=
SHOPWARE_CLIENT_ID=
SHOPWARE_CLIENT_SECRET=
SHOPWARE_SALES_CHANNEL_ID=
SHOPWARE_API_VERSION=6.0
SHOPWARE_ENABLED=false
OMNIROUTE_DEFAULT_COMBO=coding-primary
OMNIROUTE_SALES_COMBO=omnicore-sales-product-intelligence
PRODUCT_INTELLIGENCE_ENABLED=true
PRODUCT_INTELLIGENCE_AUTO_APPROVE=false
EXPORT_GATE_MODE=review_required
SHOPWARE_MCP_ENABLED=true
SHOPWARE_MCP_URL=http://shopware-mcp:7331
SHOPWARE_MCP_READ_ONLY=true

# --- Assortment & style targeting (Shopware channel) ---
# clubwear_sexy: target clubwear/nightlife; hard-exclude classic evening/ball/bridal wear.
# all: disable style targeting and evening-wear exclusion.
SHOPWARE_ASSORTMENT_PROFILE=clubwear_sexy

# --- Deterministic pricing engine (EK -> VK) ---
DEFAULT_TARGET_MARGIN_PCT=30
MIN_MARGIN_PCT=12
DEFAULT_TAX_RATE=19
PRICE_ROUNDING_MODE=point_99
