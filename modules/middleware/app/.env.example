# Copy this file to .env only when you need to override defaults.
# start.sh creates a random PostgreSQL password automatically if .env is absent.

POSTGRES_USER=omnicore
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=omnicore
OMNI_CORE_PORT=8000

# Optional external integrations. Leave blank until configured in the dashboard.
OMNIROUTE_URL=
OMNIROUTE_API_KEY=
MATTERHORN_API_TOKEN=
INTERNAL_API_KEY=
