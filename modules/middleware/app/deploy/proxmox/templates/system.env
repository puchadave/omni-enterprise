# ==============================================================================
# Omni-Core ERP & BI Middleware - System Environment Template
# ==============================================================================

# Diese Datei ist ein Beispiel für die .env Konfiguration im WaWi Container.
# Sie wird automatisch während der Installation erstellt/überschrieben.
# WICHTIG: Überschreiben Sie keine Werte ohne Verständnis der Zusammenhänge.

# ==============================================================================
# DATENBANKKONFIGURATION
# ==============================================================================

# PostgreSQL Benutzer und Datenbank
POSTGRES_USER=omnichat
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
POSTGRES_DB=omnicore

# PostgreSQL Performance-Optimierung (wird automatisch angepasst basierend auf verfügbarem RAM)
# Die folgenden Werte werden vom Bootstrap Script automatisch angepasst:
# - POSTGRES_SHARED_BUFFERS: RAM-basiert (128MB / 256MB / 512MB)
# - POSTGRES_MAX_CONNECTIONS: RAM-basiert (10 / 20 / 40)
# - POSTGRES_WORK_MEM: RAM-basiert (4MB / 8MB / 16MB)

# ==============================================================================
# OMNIROUTE GATEWAY KONFIGURATION
# ==============================================================================

# OmniRoute AI Gateway Endpunkt
# In Produktion sollte dies auf die echte Gateway-URL geändert werden
OMNI_ROUTE_URL=http://host.docker.internal:20128

# OmniRoute API Key
# Ersetzen Sie 'test-key' durch einen gültigen API Key von Ihrem OmniRoute Anbieter
OMNI_ROUTE_API_KEY=test-key

# ==============================================================================
# SERVERKONFIGURATION
# ==============================================================================

# Backend API Port
OMNI_CORE_PORT=8000

# Frontend Port
FRONTEND_PORT=3000

# ==============================================================================
# MATTERHORN IMPORT
# ==============================================================================

# Standard Matterhorn XML Import URL
MATTERHORN_API_TOKEN=https://matterhorn-moda.de/xmldata/products_full.php?type=xml

# Alternative Entwicklungs-URL
# MATTERHORN_API_TOKEN=https://matterhorn-moda.de/xmldata/products_full_dev.php?type=products_xml_ver2

# ==============================================================================
# ADMINISTRATOR ZUGANG
# ==============================================================================

# Admin E-Mail Adresse
# Wird während der ersten Anmeldung im WebIF festgelegt
ADMIN_EMAIL=admin@omni-core.local

# Admin Passwort (wird bei erster interaktiver Anmeldung gesetzt)
# Überschreiben Sie dies nicht, es sei denn, Sie verwenden non-interactive mode mit
# WAWI_ADMIN_PASSWORD=IhrPasswort in der Umgebungsvariable
# ADMIN_PASSWORD_HASH wird automatisch generiert

# ==============================================================================
# KI UND FEATURES
# ==============================================================================

# Generelle Secret Keys (werden automatisch generiert wenn nicht gesetzt)
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_32_CHARACTER_KEY
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHARACTER_KEY

# Feature Flags
ENABLE_MARKETING_ENGINE=true
ENABLE_SALES_AUTOMATION=true
ENABLE_CHANNEL_ADAPTERS=true
ENABLE_MATTERHORN_IMPORT=true

# ==============================================================================
# RESOURCENPROFIL
# ==============================================================================

# Performance Profil (wird vom Bootstrap Script automatisch erkannt und gesetzt)
# ECONOMY: für 2GB RAM oder weniger, maximale Effizienz
# BALANCED: Standard, ausgewogen (empfohlen)
# PERFORMANCE: für 4GB+ RAM, höhere Parallelität

PERFORMANCE_PROFILE=BALANCED

# ==============================================================================
# ERWEITERTE KONFIGURATION
# ==============================================================================

# Logging
LOG_LEVEL=info
LOG_FILE=/wawi/logs/application.log

# Pfade
PROJECT_DIR=/wawi
DATA_DIR=/wawi/data
LOGS_DIR=/wawi/logs

# ==============================================================================
# ENDE DER SYSTEUM-Umgebungsdatei
# ==============================================================================