# Shopware 6 - Modul-Umgebung (für Middleware-Integration)
COMPOSE_PROJECT_NAME=omni-shopware
TZ=Europe/Berlin

# Image/Port (dockware/dev = Demo/Dev inkl. integrierter DB; für Prod separates Setup nutzen)
SHOPWARE_IMAGE=dockware/dev
SHOPWARE_TAG=latest
SHOPWARE_PORT=8088
SERVICE_BIND_HOST=0.0.0.0

# Öffentliche Shop-URL (wie von außen/Middleware erreichbar; für lokale Kopplung z.B. http://shopware:80 im gemeinsamen Netz
# oder http://<host-ip>:8088). Muss zum Sales-Channel passen.
SHOPWARE_APP_URL=http://localhost:8088
SHOPWARE_HOST=localhost
SHOPWARE_SCHEME=http

# --- Middleware-Integration (Werte nach Anlage der Integration in Shopware eintragen) ---
# In Shopware Admin: Einstellungen > System > Integrationen > Integration anlegen (Admin-API-Zugriff).
# Access key ID = Client-ID, Secret access key = Client-Secret.
SHOPWARE_URL=http://localhost:8088
SHOPWARE_CLIENT_ID=
SHOPWARE_CLIENT_SECRET=
SHOPWARE_SALES_CHANNEL_ID=
SHOPWARE_API_VERSION=6.0
SHOPWARE_ENABLED=false

# Middleware-API (Ziel zum Registrieren der Shopware-Connection), falls dieses Script genutzt wird
MIDDLEWARE_URL=http://localhost:8002
MIDDLEWARE_INTERNAL_API_KEY=

# dockware Default-Admin (nur Dev/Demo; ändern/absichern in Prod): User "admin", Passwort oft "shopware" (imageabhängig)

# --- ZeroTier / Multi-Device Networking (optional) ---
ZT_ENABLED=false
ZT_NETWORK_ID=
ZT_NODE_NAME=
ZEROTIER_IMAGE=zerotier/zerotier:latest
