COMPOSE_PROJECT_NAME=omni-shopware
TZ=Europe/Berlin
SHOPWARE_IMAGE=dockware/dev
SHOPWARE_TAG=latest
SHOPWARE_PORT=8088
# dockware/dev liefert eine integrierte Demo/Dev-Umgebung (inkl. DB) – ideal für schnellen Start.
# Für Produktion: separates Setup (Shopware-App + MariaDB + Redis + ggf. OpenSearch) gemäß Shopware-Doku verwenden.

# --- ZeroTier / Multi-Device Networking (optional, for standalone on different hosts) ---
# Prefer host-installed ZeroTier (scripts/zerotier-host-setup.sh). Container sidecar via profile `zt`.
ZT_ENABLED=false
ZT_NETWORK_ID=
ZT_NODE_NAME=
ZEROTIER_IMAGE=zerotier/zerotier:latest
# Bind published ports (security): 0.0.0.0 (default), 127.0.0.1 (local-only), or a specific ZT IP
SERVICE_BIND_HOST=0.0.0.0
