<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services https://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults autowire="true" autoconfigure="true" public="false"/>

        <service id="OmniCore\Connector\Service\OmniConfigService">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="OmniCore\Connector\Service\IdempotencyService">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>

        <service id="OmniCore\Connector\Service\MiddlewareWebhookClient">
            <argument type="service" id="OmniCore\Connector\Service\OmniConfigService"/>
            <argument type="service" id="OmniCore\Connector\Service\IdempotencyService"/>
            <argument type="service" id="Symfony\Contracts\HttpClient\HttpClientInterface"/>
            <argument type="service" id="monolog.logger"/>
        </service>

        <service id="OmniCore\Connector\Subscriber\OrderEventSubscriber">
            <argument type="service" id="OmniCore\Connector\Service\MiddlewareWebhookClient"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="OmniCore\Connector\Subscriber\ProductEventSubscriber">
            <argument type="service" id="OmniCore\Connector\Service\MiddlewareWebhookClient"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="OmniCore\Connector\Controller\HealthController" public="true">
            <argument type="service" id="OmniCore\Connector\Service\OmniConfigService"/>
            <argument type="service" id="OmniCore\Connector\Service\IdempotencyService"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="OmniCore\Connector\Command\HealthCheckCommand">
            <argument type="service" id="OmniCore\Connector\Service\OmniConfigService"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <tag name="console.command" command="omnicore:connector:health"/>
        </service>
    </services>
</container>
