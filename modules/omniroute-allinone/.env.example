# OmniRoute Gateway - ALL-IN-ONE (self-contained, all configs + all API keys)
COMPOSE_PROJECT_NAME=omniroute-allinone
NODE_ID=omniroute-node-allinone
TZ=Europe/Berlin

OMNIROUTE_IMAGE=ghcr.io/local/omniroute-gateway-allinone
OMNIROUTE_TAG=1.0.0
OMNIROUTE_VERSION=latest

OMNIROUTE_PORT=20128
REQUIRE_API_KEY=true

# --- All known OmniRoute API keys (bundled) ---
# Primary key (gateway auth / client Authorization: Bearer <key>)
OMNIROUTE_API_KEY=sk-814c9467fd9c9314-a41c41-72e2d3b0
# Full list of accepted keys (comma-separated)
OMNIROUTE_API_KEYS=sk-814c9467fd9c9314-a41c41-72e2d3b0,test-key

# Set a strong fixed value in real deployments (or leave __GENERATE__ to auto-generate at first boot)
OMNIROUTE_STORAGE_ENCRYPTION_KEY=__GENERATE__

OMNIROUTE_TIMEOUT_MS=1200
OMNIROUTE_FAILOVER_TIMEOUT_MS=1400
OMNIROUTE_RETRY_429=true
OMNIROUTE_RETRY_502=true
OMNIROUTE_RETRY_503=true
OMNIROUTE_CACHE_RESPONSES=true
OMNIROUTE_CACHE_TTL_SECONDS=300

# --- ZeroTier / Multi-Device Networking (optional) ---
ZT_ENABLED=false
ZT_NETWORK_ID=
ZT_NODE_NAME=
ZEROTIER_IMAGE=zerotier/zerotier:latest
# Bind published ports (security): 0.0.0.0 (default), 127.0.0.1, or a specific ZT IP
SERVICE_BIND_HOST=0.0.0.0
