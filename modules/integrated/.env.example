# Omni Integrated Stack - alle middleware-integrierten Module gebündelt
# Enthält: Middleware+DB, OmniRoute/AI (all-in-one), Shopware (Commerce, Auto-Bootstrap),
#          Social, Marketing, Content-Studio, Coding-Swarm
COMPOSE_PROJECT_NAME=omni-integrated
TZ=Europe/Berlin
SERVICE_BIND_HOST=0.0.0.0

# --- Ports ---
MIDDLEWARE_PORT=8002
OMNIROUTE_PORT=20128
SHOPWARE_PORT=8088

# --- Core: DB & Middleware ---
POSTGRES_DB=omnicore
POSTGRES_USER=omnichat
POSTGRES_PASSWORD=change_me_strong_db_password
SESSION_SECRET=change_me_session_secret
INTERNAL_API_KEY=change_me_internal_api_key
SECRET_KEY=change_me_secret_key
JWT_SECRET=change_me_jwt_secret
OMNICORE_IMAGE=omnicore-middleware
OMNICORE_TAG=local

# --- AI / OmniRoute (all-in-one, alle Configs & Keys vorkonfiguriert) ---
OMNIROUTE_IMAGE=ghcr.io/local/omniroute-gateway-allinone
OMNIROUTE_TAG=1.0.0
OMNIROUTE_VERSION=latest
REQUIRE_API_KEY=true
OMNIROUTE_API_KEY=sk-814c9467fd9c9314-a41c41-72e2d3b0
OMNIROUTE_API_KEYS=sk-814c9467fd9c9314-a41c41-72e2d3b0,test-key
OMNIROUTE_STORAGE_ENCRYPTION_KEY=__GENERATE__
OMNIROUTE_URL_PUBLIC=

# --- Commerce / Shopware (integriert in Middleware, Auto-Bootstrap der Connection) ---
SHOPWARE_IMAGE=dockware/dev
SHOPWARE_TAG=latest
# SHOPWARE_URL ist intern im Stack auf http://shopware:80 gesetzt (Middleware erreicht Shop direkt)
SHOPWARE_URL=http://shopware:80
SHOPWARE_CLIENT_ID=
SHOPWARE_CLIENT_SECRET=
SHOPWARE_SALES_CHANNEL_ID=
SHOPWARE_API_VERSION=6.0
SHOPWARE_ENABLED=true
SHOPWARE_INTEGRATION_LABEL=omni-middleware
BOOTSTRAP_RETRY_INTERVAL=15
BOOTSTRAP_MAX_ATTEMPTS=40
BOOTSTRAP_WAIT_SEC=300

# --- Growth / Social & Marketing (Middleware-integriert) ---
SOCIAL_IMAGE=alpine:3.20
MARKETING_IMAGE=alpine:3.20

# --- AI / Content-Studio & Coding-Swarm (Middleware+OmniRoute-integriert) ---
CONTENT_STUDIO_IMAGE=alpine:3.20
CODING_SWARM_IMAGE=alpine:3.20

# --- ZeroTier (optional, Profil `zt`) ---
ZT_ENABLED=false
ZT_NETWORK_ID=
ZT_NODE_NAME=
ZEROTIER_IMAGE=zerotier/zerotier:latest
