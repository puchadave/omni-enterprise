# OmniRoute Gateway - standalone
COMPOSE_PROJECT_NAME=omniroute
NODE_ID=omniroute-node-a
TZ=Europe/Berlin

OMNIROUTE_IMAGE=diegosouzapw/omniroute
OMNIROUTE_TAG=latest
OMNIROUTE_VERSION=latest

OMNIROUTE_PORT=20128
REQUIRE_API_KEY=true
OMNIROUTE_API_KEY=__GENERATE__
OMNIROUTE_STORAGE_ENCRYPTION_KEY=__GENERATE__

OMNIROUTE_TIMEOUT_MS=1200
OMNIROUTE_FAILOVER_TIMEOUT_MS=1400
OMNIROUTE_RETRY_429=true
OMNIROUTE_RETRY_502=true
OMNIROUTE_RETRY_503=true
OMNIROUTE_CACHE_RESPONSES=true
OMNIROUTE_CACHE_TTL_SECONDS=300

# --- ZeroTier / Multi-Device Networking (optional, for standalone on different hosts) ---
# Prefer host-installed ZeroTier (scripts/zerotier-host-setup.sh). Container sidecar via profile `zt`.
ZT_ENABLED=false
ZT_NETWORK_ID=
ZT_NODE_NAME=
ZEROTIER_IMAGE=zerotier/zerotier:latest
# Bind published ports (security): 0.0.0.0 (default), 127.0.0.1 (local-only), or a specific ZT IP
SERVICE_BIND_HOST=0.0.0.0
