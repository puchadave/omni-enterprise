# Shopware MCP Server - lokaler Agent-Zugriff auf Shopware 6
COMPOSE_PROJECT_NAME=omni-shopware-mcp
TZ=Europe/Berlin
SERVICE_BIND_HOST=0.0.0.0

# Shopware Ziel (lokal: http://shopware:80 im gemeinsamen Netz oder http://host.docker.internal:8088)
SHOPWARE_URL=http://shopware:80
# Credentials aus modules/shopware/integration/credentials.env (Bootstrap)
SHOPWARE_ACCESS_KEY_ID=
SHOPWARE_SECRET_ACCESS_KEY=

# MCP Server Paket/Modus (an verfügbaren Shopware-MCP-Server anpassen)
SHOPWARE_MCP_PACKAGE=@shopware/mcp-server
SHOPWARE_MCP_ARGS=
SHOPWARE_MCP_READ_ONLY=true
MCP_TRANSPORT=http
MCP_PORT=7331
